{
  "name": "wardn-hub",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "hub/frontend",
    "hub/cli"
  ],
  "scripts": {
    "api:openapi": "cd hub/backend && uv run --extra dev python -m app.openapi --output ../frontend/openapi/wardn-hub-api.json",
    "web:api:generate": "npm run api:openapi && npm --workspace hub/frontend run api:generate",
    "web:dev": "npm --workspace hub/frontend run dev",
    "web:build": "npm --workspace hub/frontend run build",
    "web:lint": "npm --workspace hub/frontend run lint",
    "cli:build": "npm --workspace hub/cli run build",
    "cli:test": "npm --workspace hub/cli test",
    "cli:check": "npm --workspace hub/cli run check",
    "backend:test": "cd hub/backend && uv run --extra dev pytest",
    "backend:lint": "cd hub/backend && uv run --extra dev ruff check .",
    "ci:frontend-generate": "bash .github/scripts/frontend-generate.sh",
    "test:dependency-security": "node --test tests/braces.test.cjs"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "next": {
      "postcss": "8.5.31",
      "sharp": "0.35.5"
    },
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "braces": "$braces"
  },
  "devDependencies": {
    "braces": "file:packages/braces"
  }
}
